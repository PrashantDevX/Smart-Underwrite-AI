# ============= APPLICATION =============
APP_NAME=SmartUnderwrite AI
APP_VERSION=1.0.0
DEBUG=True
ENVIRONMENT=development

# ============= API CONFIGURATION =============
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=True

# ============= CORS =============
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://yourdomain.com

# ============= DATABASE =============
# Local PostgreSQL
DATABASE_URL=postgresql://postgres:password@localhost:5432/smartunderwrite

# Supabase (Alternative)
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# MongoDB Atlas (if used for document store)
# MONGODB_URL=mongodb+srv://username:password@cluster.mongodb.net/smartunderwrite?retryWrites=true&w=majority

# ============= SECURITY =============
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ============= ML MODELS =============
MODEL_PATH=./ml/models
RISK_MODEL=risk_model_lightgbm.pkl
FRAUD_MODEL=fraud_model_isolation_forest.pkl

# ============= OLLAMA (Local LLM) =============
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama2:7b

# Alternative: Use OpenAI (if needed)
# OPENAI_API_KEY=sk-...

# ============= VECTOR DATABASE (RAG) =============
CHROMA_DB_PATH=./data/chroma_db
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ============= EXTERNAL APIS (Alternative Data) =============
# Professional Profile Verification
LINKEDIN_API_KEY=your_linkedin_api_key

# Employment Verification
EMPLOYMENT_VERIFY_API_KEY=your_employment_api_key

# Utility Payment History
UTILITY_API_KEY=your_utility_api_key

# Email Verification
EMAIL_VERIFY_API_KEY=your_email_api_key

# ============= REDIS (Optional - for caching) =============
REDIS_URL=redis://localhost:6379

# ============= LOGGING =============
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# ============= DEPLOYMENT =============
# Vercel (Frontend deployment)
# No backend env vars needed - uses static build

# Render (Backend deployment)
# Set these in Render dashboard
# DATABASE_URL=[from Render PostgreSQL]
# OLLAMA_BASE_URL=[your Ollama instance]

# Railway (Alternative)
# DATABASE_URL=[from Railway PostgreSQL]

# ============= MONITORING =============
SENTRY_DSN=
PROMETHEUS_ENABLED=False

# ============= RATE LIMITING =============
RATE_LIMIT_PER_MINUTE=60

# ============= FEATURE FLAGS =============
ENABLE_FAIRNESS_AUDIT=True
ENABLE_FRAUD_CHECK=True
ENABLE_RAG=True
ENABLE_MONITORING=True
